# Local development needs no configuration: with DATABASE_URL unset the app
# uses a SQLite file at ./local.db and a dev-only session secret.

# Production (required): signs session cookies.
# SESSION_SECRET=a-long-random-string   # e.g. `openssl rand -base64 32`

# Database location. On Railway, attach a volume and leave this unset: the app
# uses $RAILWAY_VOLUME_MOUNT_PATH/colabdocs.db. Otherwise set one of:
# DATABASE_URL=file:/data/colabdocs.db
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token   # hosted libSQL only
